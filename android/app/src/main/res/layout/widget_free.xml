<?xml version="1.0" encoding="utf-8"?>
<!-- compact: one row high by default (4×1); grows if resized -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/widget_bg" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰 Free to spend" android:textColor="#FFB8B3E6" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹ —" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="1dp" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Brokeless once" android:textColor="#FFD9D6F5" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
        <TextView android:id="@+id/w_add_exp" android:layout_width="wrap_content" android:minWidth="84dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/widget_btn" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="+ Expense" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/w_add_inc" android:layout_width="wrap_content" android:minWidth="84dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/widget_btn" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="+ Income" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
